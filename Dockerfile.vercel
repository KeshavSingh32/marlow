FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
# Spring Boot serves the built frontend from the same origin as the API
COPY --from=web /web/dist ./src/main/resources/static
RUN mvn -B -q -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /src/target/marlow-0.1.0.jar app.jar
# Trust the proxy's forwarded headers, otherwise POST requests fail the CORS check
ENV SERVER_FORWARD_HEADERS_STRATEGY=framework
CMD ["sh", "-c", "exec java -Dserver.port=${PORT:-80} -jar app.jar"]
